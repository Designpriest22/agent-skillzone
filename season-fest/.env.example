# Copy to .env (or set in your hosting dashboard). All values are optional.

# Official ticket URL. When set, every GET YOUR TICKET button links straight to it.
# Takes precedence over TICKET_URL in src/config/event.ts.
PUBLIC_TICKET_URL=

# Public origin of the deployed site, used for canonical + Open Graph URLs.
SITE_URL=

# Serve the site from a sub-path, e.g. /season-fest/
BASE_PATH=
