---
import TicketCTA from './TicketCTA.astro';
import { EVENT, VENUE } from '../config/event';
---

<section class="final" id="save-room" aria-labelledby="final-title" data-final>
  <div class="final__bg" aria-hidden="true"></div>
  <canvas class="final__flames" data-final-flames aria-hidden="true"></canvas>
  <canvas class="final__particles" data-final-particles aria-hidden="true"></canvas>

  <div class="final__inner wrap">
    <h2 id="final-title" class="final__title display">
      <span data-reveal>Save room</span>
      <span data-reveal>for the <em class="fire-text">heat.</em></span>
    </h2>
    <p class="final__line" data-reveal>
      <time datetime={EVENT.date}>December 24.</time>{' '}{VENUE.name}. {VENUE.city}. {EVENT.name}.
    </p>
    <div class="final__cta" data-reveal>
      <TicketCTA variant="hero" location="final" />
    </div>
  </div>
</section>

<style>
  .final {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: min(100svh, 60rem);
    display: grid;
    align-items: center;
    padding-block: clamp(7rem, 14vw, 12rem) clamp(9rem, 18vw, 14rem);
    background: var(--obsidian);
    text-align: center;
  }

  .final__bg {
    position: absolute;
    inset: 0;
    z-index: -3;
    background:
      radial-gradient(80% 45% at 50% 105%, rgb(255 94 26 / 0.6), transparent 70%),
      radial-gradient(120% 60% at 50% 110%, rgb(117 20 27 / 0.95), transparent 75%),
      var(--obsidian);
  }

  .final__flames,
  .final__particles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s ease-out;
  }

  .final__flames {
    z-index: -2;
    mix-blend-mode: screen;
  }

  .final__particles {
    z-index: -1;
  }

  :global(.fx-on) .final__flames,
  :global(.fx-on) .final__particles {
    opacity: 1;
  }

  /* the fire sinks into the ground line before the footer */
  .final::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 22%;
    z-index: -1;
    background: linear-gradient(to top, var(--obsidian) 8%, rgb(11 8 7 / 0.6) 45%, transparent);
    pointer-events: none;
  }

  .final__inner {
    display: grid;
    justify-items: center;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .final__title {
    display: grid;
    font-size: var(--step-mega);
    line-height: 0.82;
    margin: 0;
  }

  .final__title span {
    display: block;
  }

  .final__title em {
    font-style: normal;
    padding-right: 0.04em;
  }

  .final__line {
    font: 800 clamp(1.15rem, 2.2vw, 1.75rem) / 1.3 var(--font-display);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--silver);
    max-width: 40ch;
  }

  .final__line time {
    color: var(--gold);
  }

  .final__cta {
    margin-top: 0.5rem;
  }
</style>
