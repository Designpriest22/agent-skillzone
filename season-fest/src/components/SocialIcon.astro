---
import type { SocialLink } from '../config/event';

interface Props {
  network: SocialLink['network'];
}

const { network } = Astro.props;
---

<svg class="social-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
  {
    network === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8" />
        <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8" />
        <circle cx="17.4" cy="6.6" r="1.2" fill="currentColor" />
      </>
    )
  }
  {
    network === 'x' && (
      <path
        d="M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.2L2 3h6.33l4.37 5.78L17.75 3Zm-1.08 16.18h1.7L7.4 4.73H5.58l11.09 14.45Z"
        fill="currentColor"
      />
    )
  }
  {
    network === 'tiktok' && (
      <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.5 2.6 2.4 4.4 5 4.6" fill="none" stroke="currentColor" stroke-width="1.8" />
    )
  }
  {
    network === 'facebook' && (
      <path d="M14 21v-8h3l.5-3.5H14V7.6c0-1 .3-1.7 1.8-1.7h1.8V2.8A24 24 0 0 0 15 2.7c-2.6 0-4.4 1.6-4.4 4.5v2.3H7.7V13h2.9v8" fill="currentColor" />
    )
  }
  {
    network === 'youtube' && (
      <>
        <rect x="2.5" y="5.5" width="19" height="13" rx="3.5" fill="none" stroke="currentColor" stroke-width="1.8" />
        <path d="M10 9.2v5.6l4.8-2.8z" fill="currentColor" />
      </>
    )
  }
</svg>

<style>
  .social-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
  }
</style>
