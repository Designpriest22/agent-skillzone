---
import { Picture } from 'astro:assets';
import { CONTACT, MEDIA_PARTNERS, PRODUCERS, SPONSORS } from '../config/event';
import { BRAND } from '../config/media';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const partners = [...SPONSORS, ...MEDIA_PARTNERS];
const [tcm, clique] = PRODUCERS;
---

<section class="producers section" id="producers" aria-labelledby="producers-title">
  <div class="wrap">
    <header class="producers__head">
      <p class="label label--ember" data-reveal>The producers</p>
      <h2 id="producers-title" class="producers__title display" data-split>
        Built by culture. Brought to you together.
      </h2>
      <p class="lede" data-reveal>
        SEASON FEST brings together The Capital Movement and The Clique for a Christmas Eve experience built around
        music, food, culture, and community.
      </p>
    </header>

    <div class="duo" role="list">
      <article class="duo__card" role="listitem" data-reveal>
        <div class="duo__logo duo__logo--tcm">
          <Picture
            src={BRAND.tcm.src}
            alt={BRAND.tcm.alt}
            widths={[240, 480]}
            sizes="(max-width: 48rem) 40vw, 15rem"
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            loading="lazy"
          />
        </div>
        <h3 class="duo__name">{tcm.name} <span>({tcm.shortName})</span></h3>
        <p class="duo__role label">{tcm.role}</p>
      </article>

      <div class="duo__x" aria-hidden="true" data-reveal>
        <span>×</span>
      </div>

      <article class="duo__card" role="listitem" data-reveal>
        <div class="duo__logo duo__logo--clique">
          <Picture
            src={BRAND.clique.src}
            alt={BRAND.clique.alt}
            widths={[320, 640]}
            sizes="(max-width: 48rem) 52vw, 19rem"
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            loading="lazy"
          />
        </div>
        <h3 class="duo__name">{clique.name}</h3>
        <p class="duo__role label">{clique.role}</p>
      </article>
    </div>

    <p class="producers__note serif" data-reveal>
      A co-produced edition with a shared focus on experience, culture and community.
    </p>

    <!-- Sponsors & media partners: rendered only from confirmed entries in src/config/event.ts -->
    <div class="partners" data-reveal>
      <p class="label">Sponsors &amp; media partners</p>
      {
        partners.length > 0 ? (
          <ul class="partners__list" role="list">
            {partners.map((p) => (
              <li>
                {p.url ? (
                  <a href={p.url} target="_blank" rel="noopener">
                    <img src={base + p.logo} alt={p.name} loading="lazy" decoding="async" />
                  </a>
                ) : (
                  <img src={base + p.logo} alt={p.name} loading="lazy" decoding="async" />
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="partners__empty">
            Partners will be announced here.
            {CONTACT.email && (
              <>
                {' '}
                For partnership enquiries, email <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>.
              </>
            )}
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .producers {
    background: var(--obsidian);
    border-top: 1px solid var(--line);
  }

  .producers__head {
    display: grid;
    gap: 1.25rem;
    max-width: 62rem;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  .producers__title {
    font-size: var(--step-l);
    max-width: 16ch;
  }

  .duo {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    border-block: 1px solid var(--line-strong);
  }

  .duo__card {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 1rem;
    padding: clamp(2.5rem, 6vw, 5rem) 1.5rem;
    text-align: center;
    background: radial-gradient(60% 60% at 50% 50%, rgb(255 94 26 / 0.07), transparent 70%);
  }

  .duo__logo {
    height: clamp(5.5rem, 10vw, 8.5rem);
    display: grid;
    place-items: center;
  }

  .duo__logo :global(img) {
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .duo__logo--clique {
    height: clamp(4rem, 7vw, 6rem);
  }

  .duo__logo :global(picture) {
    height: 100%;
  }

  .duo__name {
    font: 800 clamp(1.4rem, 2.4vw, 2rem) / 1 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 1rem;
  }

  .duo__name span {
    color: var(--text-mute);
  }

  .duo__role {
    color: var(--text-mute);
  }

  .duo__x {
    display: grid;
    place-items: center;
    padding-inline: clamp(1rem, 3vw, 2.5rem);
    border-inline: 1px solid var(--line);
  }

  .duo__x span {
    font: 300 clamp(3.5rem, 8vw, 7rem) / 1 var(--font-display);
    color: var(--silver);
    background: linear-gradient(180deg, #fff 0%, var(--silver) 45%, #7d746e 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .producers__note {
    margin-top: 2.5rem;
    font-size: var(--step-m);
    line-height: 1.15;
    color: var(--ember);
    max-width: 26ch;
  }

  .partners {
    margin-top: clamp(4rem, 8vw, 6rem);
    display: grid;
    gap: 1rem;
    padding: 1.75rem;
    border: 1px dashed var(--line-strong);
  }

  .partners__empty {
    color: var(--text-dim);
  }

  .partners__empty a {
    color: var(--snow);
    font-weight: 600;
    word-break: break-word;
  }

  .partners__list {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 3rem;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .partners__list img {
    height: 3rem;
    width: auto;
  }

  @media (max-width: 47.99rem) {
    .duo {
      grid-template-columns: 1fr;
    }
    .duo__x {
      border-inline: 0;
      border-block: 1px solid var(--line);
      padding-block: 0.5rem;
    }
    .duo__x span {
      font-size: 3.5rem;
    }
  }
</style>
