---
/**
 * The one and only ticket button. Every CTA on the page renders this, so the
 * label and destination stay identical everywhere.
 *
 *  - ticketUrl set  → links straight to the official ticket page (new tab).
 *  - ticketUrl null → opens the "tickets drop soon" dialog. Without JS it
 *    falls back to the #tickets block in the details section (never a dead #).
 */
import { ticketUrl, TICKET_LABEL } from '../config/event';

interface Props {
  variant?: 'hero' | 'default' | 'compact' | 'bar';
  /** Where on the page the CTA sits — used for analytics events. */
  location: string;
  class?: string;
}

const { variant = 'default', location, class: className } = Astro.props;
const live = ticketUrl !== null;
const attrs = live
  ? { href: ticketUrl, target: '_blank', rel: 'noopener', 'data-ticket-live': '' }
  : { href: '#tickets', 'data-ticket-pending': '', 'aria-haspopup': 'dialog' as const };
---

<a
  class:list={['ticket-cta', `ticket-cta--${variant}`, className]}
  data-ticket-cta
  data-cta-location={location}
  data-magnetic={variant === 'hero' || variant === 'default' ? '' : undefined}
  {...attrs}
>
  <span class="ticket-cta__glow" aria-hidden="true"></span>
  <span class="ticket-cta__body">
    <span class="ticket-cta__label">{TICKET_LABEL}</span>
    <svg class="ticket-cta__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      {
        live ? (
          <path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" />
        ) : (
          <path d="M4 12h14m-5-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" />
        )
      }
    </svg>
  </span>
  {live && <span class="visually-hidden"> (opens the official ticket page in a new tab)</span>}
</a>

<style>
  .ticket-cta {
    --h: 3.6rem;
    --notch: 0.55rem;
    --fs: 1.3rem;
    --px: 2rem;
    position: relative;
    display: inline-flex;
    isolation: isolate;
    text-decoration: none;
    border-radius: 4px;
    -webkit-tap-highlight-color: transparent;
    will-change: transform;
  }

  .ticket-cta__glow {
    position: absolute;
    inset: 18% 6%;
    z-index: -1;
    background: var(--ember);
    filter: blur(22px);
    opacity: 0.5;
    transition:
      opacity 0.35s,
      transform 0.5s var(--ease-out);
  }

  .ticket-cta__body {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    width: 100%;
    min-height: var(--h);
    padding: 0.2rem var(--px) 0 calc(var(--px) + 0.35rem);
    background: var(--molten);
    background-size: 180% 100%;
    color: #1a0905;
    font-family: var(--font-display);
    font-weight: 850;
    font-size: var(--fs);
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    -webkit-mask:
      radial-gradient(circle at 0 50%, #0000 var(--notch), #000 calc(var(--notch) + 0.5px)) 0 0 / 51% 100% no-repeat,
      radial-gradient(circle at 100% 50%, #0000 var(--notch), #000 calc(var(--notch) + 0.5px)) 100% 0 / 51% 100% no-repeat;
    mask:
      radial-gradient(circle at 0 50%, #0000 var(--notch), #000 calc(var(--notch) + 0.5px)) 0 0 / 51% 100% no-repeat,
      radial-gradient(circle at 100% 50%, #0000 var(--notch), #000 calc(var(--notch) + 0.5px)) 100% 0 / 51% 100% no-repeat;
    transition: background-position 0.6s var(--ease-out);
  }

  /* ticket perforation */
  .ticket-cta__body::before {
    content: '';
    position: absolute;
    left: calc(var(--notch) + 0.55rem);
    top: 22%;
    bottom: 22%;
    border-left: 2px dotted rgb(26 9 5 / 0.32);
  }

  /* heat shimmer */
  .ticket-cta__body::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 32%, rgb(255 244 220 / 0.6) 50%, transparent 68%);
    transform: translateX(-130%);
  }

  .ticket-cta__icon {
    width: 1.05em;
    height: 1.05em;
    flex: none;
    margin-top: -0.12em;
    transition: transform 0.45s var(--ease-out);
  }

  .ticket-cta:hover .ticket-cta__glow,
  .ticket-cta:focus-visible .ticket-cta__glow {
    opacity: 0.95;
    transform: scale(1.1);
  }

  .ticket-cta:hover .ticket-cta__body {
    background-position: 100% 0;
  }

  .ticket-cta:hover .ticket-cta__body::after {
    transform: translateX(130%);
    transition: transform 0.85s var(--ease-out);
  }

  .ticket-cta:hover .ticket-cta__icon {
    transform: translateX(4px);
  }

  .ticket-cta:active .ticket-cta__body {
    filter: brightness(0.95);
  }

  .ticket-cta:focus-visible {
    outline-offset: 5px;
  }

  /* variants */
  .ticket-cta--hero {
    --h: 4.25rem;
    --fs: 1.5rem;
    --px: 2.5rem;
    --notch: 0.65rem;
  }

  .ticket-cta--compact {
    --h: 2.75rem;
    --fs: 1rem;
    --px: 1.15rem;
    --notch: 0.42rem;
  }

  .ticket-cta--compact .ticket-cta__glow {
    opacity: 0.3;
    filter: blur(14px);
  }

  .ticket-cta--bar {
    --h: 3.25rem;
    --fs: 1.2rem;
    display: flex;
    width: 100%;
  }

  /* idle heat pulse on the hero CTA, so it reads as the primary action */
  @media (prefers-reduced-motion: no-preference) {
    .ticket-cta--hero .ticket-cta__body::after {
      animation: shimmer 5.5s var(--ease-in-out) 2.2s infinite;
    }
    .ticket-cta--hero:hover .ticket-cta__body::after {
      animation: none;
    }
  }

  @keyframes shimmer {
    0%,
    72% {
      transform: translateX(-130%);
    }
    100% {
      transform: translateX(130%);
    }
  }

  @media (max-width: 30rem) {
    .ticket-cta--hero {
      --fs: 1.35rem;
      --h: 4rem;
      --px: 1.75rem;
    }
  }

  @media (forced-colors: active) {
    .ticket-cta__body {
      border: 2px solid ButtonText;
      -webkit-mask: none;
      mask: none;
    }
  }
</style>
