# Destination Nigeria — environment variables.
# Copy to .env.local for development. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; everything else stays on the server.

# ——— Site ———
# Absolute production origin, no trailing slash. Used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.example.org
# Set to "off" on preview/staging deployments to block all crawling via robots.txt.
SITE_INDEXING=on
# Google Search Console HTML-tag verification token (content value only).
GOOGLE_SITE_VERIFICATION=

# ——— Form delivery (configure at least one, or forms answer "not switched on yet") ———
# Any HTTPS endpoint that accepts JSON: CRM workflow, Zapier/Make/n8n webhook, serverless function.
FORMS_WEBHOOK_URL=
# Optional shared secret; requests carry X-Destination-Nigeria-Signature = hex HMAC-SHA256(body).
FORMS_WEBHOOK_SECRET=
# Email notifications via Resend (https://resend.com). FORMS_FROM must be a verified sender domain.
RESEND_API_KEY=
FORMS_NOTIFY_TO=enquiries@example.org
FORMS_FROM="Destination Nigeria <no-reply@example.org>"
# Newsletter list in Brevo (https://www.brevo.com). Contacts get DN_AUDIENCE and DN_INTERESTS attributes.
BREVO_API_KEY=
BREVO_LIST_ID=
# Local development only: append submissions to .data/submissions.jsonl (git-ignored). Never enable in production.
FORMS_FILE_STORE=

# ——— Analytics (optional, consent-gated, cookieless) ———
# Your site's domain as registered in Plausible. Leave empty to disable analytics and the consent banner.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Script URL. Change only for a self-hosted Plausible instance.
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
