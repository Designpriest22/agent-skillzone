# Copy to .env.local for local development. Production values live in the hosting provider's secret store.
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgres://rtc:rtc@localhost:5432/rtc
# 32+ random characters: openssl rand -hex 32
SESSION_SECRET=
# Paystack keys are added by TCM at launch. Without them Naira checkout returns 503 and nothing is charged.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
