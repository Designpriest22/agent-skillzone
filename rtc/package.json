{
  "name": "run-the-capital",
  "version": "0.2.0",
  "private": true,
  "description": "Run The Capital: an Abuja street-fighting game by The Capital Movement.",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/migrate.ts --reset",
