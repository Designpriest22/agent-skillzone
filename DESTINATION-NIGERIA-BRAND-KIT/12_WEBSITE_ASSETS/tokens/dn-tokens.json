{
  "color": {
    "forest": {
      "$type": "color",
      "$value": "#103428",
      "$description": "Forest Deep \u2014 Primary brand colour. Wordmark, headlines, institutional backgrounds, body text on light grounds."
    },
    "ridge": {
      "$type": "color",
      "$value": "#2C5040",
      "$description": "Ridge Green \u2014 Mountain tone in the logo. Secondary backgrounds, panels, charts, hover states."
    },
    "gold": {
      "$type": "color",
      "$value": "#E8A432",
      "$description": "Sun Gold \u2014 The sun. Single focal accent: sun disc, key numbers, buttons on dark. Never for small text on light."
    },
    "ivory": {
      "$type": "color",
      "$value": "#F5F0E6",
      "$description": "Harmattan Ivory \u2014 Default light ground for documents, presentations and web. Warmer than white."
    },
    "white": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "White \u2014 Reversed logo, paper white, UI surfaces."
    },
    "mist": {
      "$type": "color",
      "$value": "#EAEAEA",
      "$description": "Mist \u2014 Horizon line tone in the supplied reversed logo. Hairlines and dividers on dark grounds."
    },
    "canopy": {
      "$type": "color",
      "$value": "#4E7A62",
      "$description": "Canopy Green \u2014 Supporting green for charts, icons and illustration layers."
    },
    "sage": {
      "$type": "color",
      "$value": "#A9BFA9",
      "$description": "Sage \u2014 Light green tint for table bands, map land, background contours."
    },
    "charcoal": {
      "$type": "color",
      "$value": "#1B201E",
      "$description": "Charcoal \u2014 Darkest neutral (green-black). Cinematic backgrounds, long-form body text alternative."
    },
    "stone": {
      "$type": "color",
      "$value": "#5F6662",
      "$description": "Stone \u2014 Captions, metadata, footnotes, secondary UI text (passes AA on white and ivory)."
    },
    "haze": {
      "$type": "color",
      "$value": "#E7DFCF",
      "$description": "Haze \u2014 Deeper ivory for cards, table headers and print panels."
    },
    "laterite": {
      "$type": "color",
      "$value": "#B4532A",
      "$description": "Laterite \u2014 Red-earth accent drawn from Nigeria's laterite soils. Culture and heritage stories; sparingly."
    },
    "savannah": {
      "$type": "color",
      "$value": "#D8C49B",
      "$description": "Savannah \u2014 Dry-season grass and sand. Illustration layers, photo-overlay warmth, map water-free land."
    },
    "confluence": {
      "$type": "color",
      "$value": "#2E6E76",
      "$description": "Confluence Blue \u2014 River and coastline tone (Niger\u2013Benue). Maps, routes, information graphics, digital links on light."
    },
    "golddeep": {
      "$type": "color",
      "$value": "#9A6510",
      "$description": "Harvest Gold \u2014 Accessible gold for text and icons on light grounds (AA for large text and UI on ivory)."
    }
  },
