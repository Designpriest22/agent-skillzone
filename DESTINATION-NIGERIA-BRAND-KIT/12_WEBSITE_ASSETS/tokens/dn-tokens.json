{
  "color": {
    "forest": {
      "$type": "color",
      "$value": "#103428",
      "$description": "Forest \u2014 The brand's voice. Wordmark, headlines, text on paper, the dark ground of covers and screens."
    },
    "ridge": {
      "$type": "color",
      "$value": "#2C5040",
      "$description": "Ridge \u2014 The mountain tone in the logo. Second surface on Forest, chart series, rules on dark grounds."
    },
    "gold": {
      "$type": "color",
      "$value": "#E8A432",
      "$description": "Sun Gold \u2014 The sun, and only the sun: the disc, one key figure, one call to action. Never text on paper. Under 3 % of any layout."
    },
    "ivory": {
      "$type": "color",
      "$value": "#F5F0E6",
      "$description": "Paper \u2014 The default ground for print, slides and web. A warm, uncoated-paper white."
    },
    "white": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "White \u2014 Reversed logo, UI surfaces, photography mounts."
    },
    "charcoal": {
      "$type": "color",
      "$value": "#1B201E",
      "$description": "Ink \u2014 Body text in long documents, the darkest ground behind photography and film."
    },
    "stone": {
      "$type": "color",
      "$value": "#5F6662",
      "$description": "Stone \u2014 Captions, metadata, footnotes, secondary text. Passes AA on Paper and White."
    },
    "haze": {
      "$type": "color",
      "$value": "#E7DFCF",
      "$description": "Haze \u2014 Hairlines on Paper, table bands, the second paper tone."
    },
    "sage": {
      "$type": "color",
      "$value": "#A9BFA9",
      "$description": "Sage \u2014 Data only: the second chart series and map land. Not a background colour."
    },
    "golddeep": {
      "$type": "color",
      "$value": "#8A5A0C",
      "$description": "Gold Text \u2014 Accessible gold for figures and links on Paper (AA for text). Used where Sun Gold would fail contrast."
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Newsreader Display",
        "Georgia",
        "Times New Roman",
        "serif"
      ]
    },
    "text": {
      "$type": "fontFamily",
      "$value": [
        "Newsreader Text",
        "Georgia",
        "Cambria",
        "serif"
      ]
    },
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Public Sans",
        "Arial",
        "Helvetica Neue",
        "sans-serif"
      ]
    }
  },
  "type": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 400,
        "fontSize": "6rem",
        "lineHeight": 0.98,
        "letterSpacing": "-0.02em"
      },
      "$description": "One line per layout at most: covers, campaign posters, the opening slide"
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 400,
        "fontSize": "3.5rem",
        "lineHeight": 1.04,
        "letterSpacing": "-0.015em"
      },
      "$description": "Titles: document titles, section openers, slide titles"
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 500,
        "fontSize": "2.25rem",
        "lineHeight": 1.12,
        "letterSpacing": "-0.01em"
      },
      "$description": "Sub-section headings"
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 600,
        "fontSize": "1.25rem",
        "lineHeight": 1.3,
        "letterSpacing": "0em"
      },
      "$description": "Headings inside text, card and table titles"
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 600,
        "fontSize": "0.75rem",
        "lineHeight": 1.3,
        "letterSpacing": "0.08em"
      },
      "$description": "Labels and section markers. Uppercase, used once per block, never as decoration"
    },
    "lead": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.text}",
        "fontWeight": 400,
        "fontSize": "1.375rem",
        "lineHeight": 1.42,
        "letterSpacing": "0em"
      },
      "$description": "Standfirst and executive-summary lead"
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 400,
        "fontSize": "1rem",
        "lineHeight": 1.6,
        "letterSpacing": "0em"
      },
      "$description": "Body text in digital and UI; 10 pt in documents"
    },
    "body-long": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.text}",
        "fontWeight": 400,
        "fontSize": "1.0625rem",
        "lineHeight": 1.55,
        "letterSpacing": "0em"
      },
      "$description": "Long-form print reading; 10.5 pt in reports"
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 400,
        "fontSize": "0.75rem",
        "lineHeight": 1.45,
        "letterSpacing": "0em"
      },
      "$description": "Place captions (Place, State), credits, metadata"
    },
    "footnote": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 400,
        "fontSize": "0.625rem",
        "lineHeight": 1.4,
        "letterSpacing": "0em"
      },
      "$description": "Sources, notes, legal lines"
    },
    "table": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 400,
        "fontSize": "0.875rem",
        "lineHeight": 1.35,
        "letterSpacing": "0em"
      },
      "$description": "Tables, tabular lining figures (tnum, lnum)"
    },
    "figure": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 400,
        "fontSize": "4.5rem",
        "lineHeight": 1.0,
        "letterSpacing": "-0.02em"
      },
      "$description": "A single key figure, with its unit and source in caption size"
    },
    "button": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 600,
        "fontSize": "0.9375rem",
        "lineHeight": 1.0,
        "letterSpacing": "0.01em"
      },
      "$description": "Buttons and links in UI"
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
