# ---------------------------------------------------------------------------
# Over Sabi environment. Copy to .env.local for development.
# Only DATABASE_URL and SESSION_SECRET are required. Every integration below is
# optional: when its key is missing the feature reports "not configured" in the UI
# instead of pretending to work. Never commit real values.
# ---------------------------------------------------------------------------

# Required ------------------------------------------------------------------
# Postgres connection (local Postgres or Supabase "Session pooler"/direct URL).
DATABASE_URL=postgres://oversabi:oversabi@localhost:5432/oversabi_dev
# Set to "false" when connecting through a transaction pooler (Supabase port 6543).
DATABASE_PREPARE=true
DATABASE_POOL_SIZE=10
# Public base URL of the app (used in emails, OAuth redirects, payment callbacks).
APP_URL=http://localhost:3000
# At least 32 random characters: `openssl rand -hex 32`
SESSION_SECRET=

# AI tutor (Anthropic) -------------------------------------------------------
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-opus-5-5
# low | medium | high — low keeps conversational latency down.
TUTOR_EFFORT=low

# Speech: none | openai | elevenlabs -----------------------------------------
SPEECH_PROVIDER=none
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_v3
# A licensed voice from your ElevenLabs library. Never a clone of a real person without written consent.
ELEVENLABS_VOICE_ID=

# Email (Resend) -------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Over Sabi <hello@your-domain.com>

# Google sign-in (OAuth client, redirect URI: $APP_URL/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payments (Paystack) --------------------------------------------------------
# Webhook URL to register in Paystack: $APP_URL/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Storage for contributor recordings: local | supabase ------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
SUPABASE_URL=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=oversabi-audio
# Origin for media CSP if audio is ever served directly from storage.
STORAGE_PUBLIC_ORIGIN=

# Operations ------------------------------------------------------------------
# Bearer secret for POST /api/cron/daily (retention, reminders, cleanup).
CRON_SECRET=
TRANSCRIPT_RETENTION_DAYS=90

# Test only — enables deterministic AI/speech doubles. Ignored when NODE_ENV=production.
OVERSABI_TEST_PROVIDERS=
