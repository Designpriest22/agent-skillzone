# ─── Core ────────────────────────────────────────────────────────────────
# PostgreSQL (local docker-compose, Supabase, Neon, RDS…). For Supabase's transaction pooler (port 6543) also set DATABASE_PREPARE=false.
DATABASE_URL=postgres://prohub:prohub@localhost:5432/prohub
DATABASE_PREPARE=true
DATABASE_POOL_SIZE=10
# Public URL of this app (used in notification links, sitemap, payment callbacks)
APP_URL=http://localhost:3000
# 32 random bytes, base64 — encrypts integration credentials at rest:  openssl rand -base64 32
ENCRYPTION_KEY=
BUSINESS_TIMEZONE=Africa/Lagos

# First owner account (created by `npm run db:seed` if no users exist). If OWNER_PASSWORD is empty a random one is printed once.
OWNER_EMAIL=owner@prohub.ng
OWNER_NAME=Owner
OWNER_PASSWORD=

# ─── Worker ──────────────────────────────────────────────────────────────
# standalone: run `npm run worker` as a separate process (recommended)
# embedded:   worker runs inside the Next.js server (single-service hosts)
# cron:       serverless — call /api/cron/tick every minute with Bearer CRON_SECRET
WORKER_MODE=standalone
WORKER_CONCURRENCY=3
CRON_SECRET=

# ─── AI ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Each agent has a cost-routed default model (Opus for the MD and copy, Sonnet for specialists, Haiku for finance narration).
# DEFAULT_AGENT_MODEL is used when DEFAULT_AGENT_MODEL_FORCE=true (applies at seed time; change models per agent in the dashboard).
DEFAULT_AGENT_MODEL=claude-opus-5-5
DEFAULT_AGENT_MODEL_FORCE=false
# Optional: route via a gateway (leave empty for api.anthropic.com)
ANTHROPIC_API_BASE_URL=

# Image / video generation (optional)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
VIDEO_API_URL=
VIDEO_API_KEY=
# Built-in video renderer (worker): Chromium + ffmpeg. Docker image sets CHROMIUM_PATH=/usr/bin/chromium.
CHROMIUM_PATH=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ─── Communication ───────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Prohub Creative Solutions <hello@prohub.ng>"

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PUBLIC_NUMBER=
META_APP_SECRET=
# WhatsApp command centre: numbers (comma-separated, international format) bound to the owner at `npm run setup`.
# Add/remove numbers later in Settings → Command channels.
WHATSAPP_OWNER_NUMBERS=
# Approved utility template with one body variable, used when the 24h window is closed (e.g. prohub_update)
WHATSAPP_OWNER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Voice-note transcription uses OPENAI_API_KEY (Claude doesn't take audio input)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# ─── Marketing ───────────────────────────────────────────────────────────
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
META_VERIFY_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=
TIKTOK_ACCESS_TOKEN=
YOUTUBE_API_KEY=

# ─── Business ────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Development ─────────────────────────────────────────────────────────
VERCEL_DEPLOY_HOOK_URL=
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
