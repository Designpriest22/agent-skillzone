{
  "name": "prohub-os",
  "version": "0.1.0",
  "private": true,
  "description": "Prohub AI Business Operating System — a multi-agent digital workforce for Prohub Creative Solutions",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "agent:smoke": "tsx --env-file-if-exists=.env scripts/agent-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "clsx": "^2.1.1",
    "croner": "^9.1.0",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.66.0",
    "next": "^16.2.12",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.20.2",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
